# ============================================================
# "Huquqim" — barcha sozlamalar faqat shu fayl orqali (.env ga nusxalang)
# Kalit bo'lmasa ham loyiha ishlaydi: shablon javob / faqat matn rejimi.
# ============================================================

APP_NAME=Huquqim
ENV=dev
LOG_LEVEL=INFO

# --- Ma'lumotlar bazasi (MVP: SQLite, keyin Postgres URL qo'yish mumkin) ---
DATABASE_URL=sqlite:///./data/huquqim.db

# --- LLM. Kalit bo'lmasa: kartadan shablon javob ---
# anthropic | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Gemini: model nomlari startup'da tekshiriladi (asosiy -> zaxira -> shablon)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_MODEL=claude-sonnet-5-5
# low | medium | high  (bot uchun tezlik muhim -> low)
LLM_EFFORT=low
# LLM so'roviga qat'iy chegara (s): o'tsa yoki xato bo'lsa — darhol shablon javob
LLM_TIMEOUT=8
LLM_MAX_TOKENS=2000

# --- STT (ovoz -> matn). none | openai | faster_whisper | gemini ---
# gemini: GEMINI_API_KEY bilan ishlaydi (model — GEMINI_MODEL), timeout 15 s
STT_PROVIDER=none
# openai-mos Whisper API (OpenAI yoki boshqa mos provayder)
STT_API_BASE=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=uz
STT_TIMEOUT=30
# faster_whisper uchun model o'lchami (tiny/base/small/medium)
FASTER_WHISPER_SIZE=small

# --- TTS (matn -> ovoz). edge | none ---
TTS_PROVIDER=edge
TTS_VOICE_UZ=uz-UZ-MadinaNeural
TTS_VOICE_RU=ru-RU-SvetlanaNeural
TTS_TIMEOUT=15

# --- Klassifikator ---
CLASSIFIER_THRESHOLD=0.35
# true bo'lsa sentence-transformers ishlatiladi (pip install sentence-transformers)
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# polling | webhook
BOT_MODE=polling
BOT_WEBHOOK_PATH=/tg/webhook
BOT_WEBHOOK_SECRET=change-me
BOT_HOST=0.0.0.0
BOT_PORT=8081
# bot backendga shu manzil orqali murojaat qiladi
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT=25

# --- Domen / Mini App (keyinroq) ---
# masalan https://huquqim.example.uz  (webhook va havolalar uchun)
PUBLIC_BASE_URL=
# masalan https://huquqim.example.uz/miniapp
WEBAPP_URL=

# --- Web / xavfsizlik ---
CORS_ORIGINS=*
# Bo'sh bo'lmasa, /api/gov/* uchun "X-Admin-Token" sarlavhasi talab qilinadi
ADMIN_TOKEN=
# Bo'sh bo'lmasa, bot -> backend profil so'rovlari "X-Internal-Token" bilan imzolanadi
# (aks holda istalgan mijoz Telegram chat_id nomidan profil ulashi mumkin — faqat demo uchun bo'sh qoldiring)
INTERNAL_API_TOKEN=
# Eslatma/alert yuboruvchi fon jarayoni (sekund)
NOTIFIER_INTERVAL=300
